# Backend service ports
API_GATEWAY_PORT=8080
AGENT_ENGINE_PORT=8081
CONNECTOR_HUB_PORT=8082
AUTH_SERVICE_PORT=8083
OBSERVABILITY_SERVICE_PORT=8084

# Shared services
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_builder
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
VAULT_ADDR=http://localhost:8200

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Connector hub / OAuth
# Use provider-specific redirect URIs that point at your local callback handler.
# If you centralize callbacks in the connector hub instead of the web app, update these values.
CONNECTOR_HUB_BASE_URL=http://localhost:8082

# GitHub Models
# Server-side only. Do NOT expose this with NEXT_PUBLIC_.
GITHUB_MODELS_API_KEY=YOUR_GITHUB_MODELS_API_KEY
# Optional, if your client expects an explicit endpoint.
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
GITHUB_MODELS_MODEL=gpt-4o

# Slack OAuth
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
SLACK_REDIRECT_URI=http://localhost:3000/callback/slack
SLACK_BOT_SCOPES=chat:write,channels:read,groups:read,users:read
SLACK_USER_SCOPES=

# Notion OAuth
NOTION_CLIENT_ID=YOUR_NOTION_CLIENT_ID
NOTION_CLIENT_SECRET=YOUR_NOTION_CLIENT_SECRET
NOTION_REDIRECT_URI=http://localhost:3000/callback/notion
NOTION_SCOPES=read_content,update_content,insert_content

# Mock token vault – Notion integration token used by the adapter.
MOCK_TOKEN_NOTION=YOUR_NOTION_INTEGRATION_TOKEN

# Google OAuth
# Google Calendar and Gmail normally share the same OAuth app credentials.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/callback/google
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/calendar.events
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send

# Mock vault token for Google Workspace connector.
# Read by SecretVault::from_env() via the MOCK_TOKEN_* prefix convention.
# API key (AIzaSy* prefix)  → read-only public Calendar + Drive endpoints.
# OAuth token (ya29.* prefix) → Gmail, Calendar writes, private Drive.
# Obtain an OAuth token via the Google OAuth flow using GOOGLE_CLIENT_ID above.
MOCK_TOKEN_GOOGLE_WORKSPACE=YOUR_GOOGLE_WORKSPACE_ACCESS_TOKEN

# GitHub OAuth
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_APP_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_APP_CLIENT_SECRET
GITHUB_REDIRECT_URI=http://localhost:3000/callback/github
GITHUB_SCOPES=repo,read:user,user:email,read:org

# Discord OAuth
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_REDIRECT_URI=http://localhost:3000/callback/discord
DISCORD_SCOPES=identify,guilds,messages.read
ZETA_TOKEN=xapp-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

