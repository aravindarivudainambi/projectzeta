# Backend service ports
API_GATEWAY_PORT=8080
AGENT_ENGINE_PORT=8081
CONNECTOR_HUB_PORT=8082
AUTH_SERVICE_PORT=8083
OBSERVABILITY_SERVICE_PORT=8084

# Shared services
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_builder
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
VAULT_ADDR=http://localhost:8200

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# GitHub Models
# Server-side only. Do NOT expose this with NEXT_PUBLIC_.
GITHUB_MODELS_API_KEY=YOUR_GITHUB_MODELS_API_KEY
# Optional, if your client expects an explicit endpoint.
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
ZETA_TOKEN=xapp-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
